rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && (
          request.auth.token.firebase.sign_in_provider != 'password'
          || request.auth.token.email_verified == true
        );
    }

    // Per-user root sync document and scalable subcollections (playlists, liked_chunks)
    match /users/{userId} {
      allow read, write: if isSignedInOwner(userId);

      match /playlists/{playlistId} {
        allow read, write: if isSignedInOwner(userId);
      }

      match /liked_chunks/{chunkId} {
        allow read, write: if isSignedInOwner(userId);
      }

      match /listening_sessions/{sessionId} {
        allow read, write: if isSignedInOwner(userId);
      }
    }

    // Deny all other paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
